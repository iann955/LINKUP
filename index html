<!DOCTYPE html><html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>LINKUP — Connect. Discover. Grow.</title><style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  background: #0b1020;
  color: white;
  min-height: 100vh;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20px;
  max-width: 1100px;
  margin: auto;
}

.logo {
  font-size: 25px;
  font-weight: 800;
}

.logo span {
  color: #4f8cff;
}

.login {
  color: white;
  text-decoration: none;
  border: 1px solid #34405c;
  padding: 10px 16px;
  border-radius: 10px;
}

.hero {
  text-align: center;
  padding: 80px 20px 50px;
  max-width: 900px;
  margin: auto;
}

.hero h1 {
  font-size: clamp(42px, 9vw, 76px);
  line-height: 1;
  margin-bottom: 22px;
}

.hero h1 span {
  color: #4f8cff;
}

.hero p {
  color: #aeb8cc;
  font-size: 18px;
  line-height: 1.6;
  max-width: 650px;
  margin: auto;
}

.buttons {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
  margin-top: 32px;
}

.btn {
  border: none;
  padding: 15px 25px;
  border-radius: 12px;
  font-size: 16px;
  font-weight: bold;
  cursor: pointer;
}

.primary {
  background: #4f8cff;
  color: white;
}

.secondary {
  background: transparent;
  color: white;
  border: 1px solid #34405c;
}

.section {
  max-width: 1050px;
  margin: auto;
  padding: 55px 20px;
}

.section h2 {
  text-align: center;
  font-size: 34px;
  margin-bottom: 12px;
}

.subtitle {
  text-align: center;
  color: #9faabe;
  margin-bottom: 30px;
}

.cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
  gap: 18px;
}

.card {
  background: #131b30;
  border: 1px solid #25304a;
  border-radius: 18px;
  padding: 25px;
}

.card h3 {
  margin-bottom: 10px;
}

.card p {
  color: #aeb8cc;
  line-height: 1.6;
}

.icon {
  font-size: 32px;
  margin-bottom: 15px;
}

.cta {
  text-align: center;
  background: #131b30;
  border: 1px solid #25304a;
  border-radius: 24px;
  padding: 45px 20px;
  margin-bottom: 50px;
}

footer {
  text-align: center;
  padding: 30px;
  color: #77829a;
  border-top: 1px solid #202a40;
}

.modal {
  display: none;
  position: fixed;
  inset: 0;
  background: rgba(0,0,0,.75);
  align-items: center;
  justify-content: center;
  padding: 20px;
}

.modal-box {
  width: 100%;
  max-width: 420px;
  background: #131b30;
  border: 1px solid #2b3855;
  border-radius: 20px;
  padding: 30px;
}

.modal-box h2 {
  margin-bottom: 10px;
}

.modal-box p {
  color: #aeb8cc;
  margin-bottom: 20px;
}

.option {
  width: 100%;
  padding: 17px;
  margin-top: 12px;
  border-radius: 12px;
  border: 1px solid #34405c;
  background: #0b1020;
  color: white;
  font-size: 16px;
  cursor: pointer;
}

.close {
  margin-top: 20px;
  width: 100%;
  padding: 12px;
  background: transparent;
  border: none;
  color: #8894aa;
  cursor: pointer;
}
</style></head><body><header>
  <div class="logo">LINK<span>UP</span></div>
  <a href="#" class="login" onclick="openLogin()">Login</a>
</header><section class="hero">
  <h1>Connect.<br><span>Discover. Grow.</span></h1>  <p>
    LINKUP connects people with businesses, services and opportunities
    in one simple platform.
  </p>  <div class="buttons">
    <button class="btn primary" onclick="openJoin()">
      GET STARTED
    </button><button class="btn secondary" onclick="scrollToFeatures()">
  EXPLORE
</button>

  </div>
</section><section class="section" id="features">  <h2>Everything in one place</h2>  <p class="subtitle">
    Built for customers and businesses.
  </p>  <div class="cards"><div class="card">
  <div class="icon">🔎</div>
  <h3>Discover</h3>
  <p>
    Find businesses, services and opportunities that match what you need.
  </p>
</div>

<div class="card">
  <div class="icon">📅</div>
  <h3>Book</h3>
  <p>
    Request services and manage appointments from one place.
  </p>
</div>

<div class="card">
  <div class="icon">💬</div>
  <h3>Connect</h3>
  <p>
    Communicate directly with businesses and customers.
  </p>
</div>

<div class="card">
  <div class="icon">📈</div>
  <h3>Grow</h3>
  <p>
    Businesses can reach new customers and build their online presence.
  </p>
</div>

  </div>
</section><section class="section">  <div class="cta"><h2>Who are you?</h2>

<p class="subtitle">
  Choose how you want to use LINKUP.
</p>

<div class="buttons">

  <button class="btn primary" onclick="chooseUser('Customer')">
    I'm a Customer
  </button>

  <button class="btn secondary" onclick="chooseUser('Business')">
    I'm a Business
  </button>

</div>

  </div></section><footer>
  © 2026 LINKUP. All rights reserved.
</footer><div class="modal" id="joinModal">  <div class="modal-box"><h2>Join LINKUP</h2>

<p>
  Choose an account type to continue.
</p>

<button class="option" onclick="chooseUser('Customer')">
  👤 Create Customer Account
</button>

<button class="option" onclick="chooseUser('Business')">
  🏢 Create Business Account
</button>

<button class="close" onclick="closeJoin()">
  Cancel
</button>

  </div></div><div class="modal" id="loginModal">  <div class="modal-box"><h2>LINKUP Login</h2>

<p>
  Login will be connected to your Supabase account in the next step.
</p>

<button class="btn primary" style="width:100%;" onclick="closeLogin()">
  Continue
</button>

  </div></div><script>

function openJoin() {
  document.getElementById("joinModal").style.display = "flex";
}

function closeJoin() {
  document.getElementById("joinModal").style.display = "none";
}

function openLogin() {
  document.getElementById("loginModal").style.display = "flex";
}

function closeLogin() {
  document.getElementById("loginModal").style.display = "none";
}

function chooseUser(type) {

  alert(
    type +
    " account selected. Account creation will be connected to Supabase next."
  );

  closeJoin();
}

function scrollToFeatures() {
  document.getElementById("features").scrollIntoView({
    behavior: "smooth"
  });
}

</script></body>
</html>